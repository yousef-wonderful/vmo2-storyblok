# Storyblok. Copy to .env.local and fill in. Never commit .env.local.

# Region your space lives in: eu | us | ca | ap | cn  (shown in Space settings; EU is the default)
STORYBLOK_REGION=eu

# Numeric space ID: Space settings → General, or the number in the app URL (app.storyblok.com/#/me/spaces/<ID>/...)
STORYBLOK_SPACE_ID=

# Management API (seed script + MCP server). My account → Personal access tokens → Generate. Shown once.
STORYBLOK_PERSONAL_ACCESS_TOKEN=

# Content Delivery API (the Next.js app reads draft + published content with it). Space settings → Access tokens → Preview.
STORYBLOK_PREVIEW_TOKEN=

# Where the Visual Editor loads the site. Seed sets this on the space.
STORYBLOK_PREVIEW_URL=https://localhost:3010/preview/
